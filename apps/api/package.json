{
  "name": "@barber/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply barber_db --local",
    "seed:local": "wrangler d1 execute barber_db --local --file ../../scripts/seed-local.sql",
    "reset:local": "node ../../scripts/reset-local-d1.mjs",
    "migrate:remote": "wrangler d1 migrations apply barber_db --remote"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.116.0"
  }
}
