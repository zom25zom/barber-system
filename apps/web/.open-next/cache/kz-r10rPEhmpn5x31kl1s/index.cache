content=\"black-translucent\"/><link href=\"https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-[var(--bs-bg)] text-[var(--bs-text)] antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><script>((a,b,c,d,e,f,g,h)=>{let i=document.documentElement,j=[\"light\",\"dark\"];function k(b){var c;(Array.isArray(a)?a:[a]).forEach(a=>{let c=\"class\"===a,d=c&&f?e.map(a=>f[a]||a):e;c?(i.classList.remove(...d),i.classList.add(f&&f[b]?f[b]:b)):i.setAttribute(a,b)}),c=b,h&&j.includes(c)&&(i.style.colorScheme=c)}if(d)k(d);else try{let a=localStorage.getItem(b)||c,d=g&&\"system\"===a?window.matchMedia(\"(prefers-color-scheme: dark)\").matches?\"dark\":\"light\":a;k(d)}catch(a){}})(\"class\",\"theme\",\"system\",null,[\"light\",\"dark\"],null,true,true)</script><main class=\"w-full px-4 py-6\"><div class=\"bs-skin\"><section class=\"relative -mx-4 overflow-hidden\"><div class=\"absolute inset-0 bg-[var(--bs-surface)]\"></div><div class=\"absolute inset-0\" style=\"background:radial-gradient(ellipse 70% 90% at 82% -12%, #C9A2272E, transparent 62%)\"></div><div class=\"absolute inset-0\" style=\"background:radial-gradient(ellipse 40% 55% at 8% 108%, rgba(201,162,39,0.10), transparent 70%)\"></div><div class=\"bs-grain\"></div><div class=\"relative mx-auto max-w-6xl px-4 pb-16 pt-12 sm:pb-20 sm:pt-16\"><div class=\"flex items-center gap-3\"><span class=\"text-2xl\">💈</span><span class=\"text-[11px] font-bold tracking-[0.35em] text-[var(--bs-primary)]\" dir=\"ltr\">BARBER BOOKING SAAS</span><span class=\"bs-hairline hidden flex-1 sm:block\"></span></div><h1 class=\"mt-6 max-w-3xl text-4xl font-black leading-[1.15] text-[var(--bs-text)] sm:mt-8 sm:text-6xl\">نظام حجز مواعيد يدير صالونك<span class=\"text-[var(--bs-primary)]\"> عنك</span>.</h1><p class=\"mt-6 max-w-xl text-base leading-relaxed text-[var(--bs-text-muted)] sm:text-lg\">منصة سحابية للحلاقين والصالونات — أعطِ زبائنك حجزاً إلكترونياً سهلاً، واستقبل إشعارات وتقارير وتذكيرات تلقائية، بدون تطبيقات ولا تعقيد. سجّل صالونك مجاناً خلال دقيقة واحدة.</p><div class=\"mt-9 flex flex-col items-start gap-5 sm:flex-row sm:items-center\"><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap font-bold transition-all active:scale-95 disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--bs-primary)]/50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-[var(--bs-primary)] text-[var(--bs-on-primary)] hover:bg-[var(--bs-primary-strong)] h-12 rounded-2xl px-10 text-base shadow-lg shadow-[var(--bs-primary)]/20\" href=\"/signup\">أنشئ صالونك مجاناً <span aria-hidden=\"true\">←</span></a><a href=\"#features\" class=\"text-sm font-bold text-[var(--bs-text-faint)] transition-colors hover:text-[var(--bs-primary)]\">اكتشف المزايا ↓</a></div><p class=\"mt-6 text-sm text-[var(--bs-text-muted)]\">لديك صالون مسجّل بالفعل؟<!-- --> <a class=\"font-bold text-[var(--bs-primary)] hover:underline\" href=\"/admin/login\">دخول لوحة التحكم</a></p></div></section><section id=\"features\" class=\"scroll-mt-8 py-14 sm:py-20\"><div class=\"flex items-center gap-3\"><span class=\"text-[11px] font-bold tracking-[0.35em] text-[var(--bs-primary)]\" dir=\"ltr\">FEATURES</span><span class=\"bs-hairline flex-1\"></span></div><h2 class=\"mt-4 text-3xl font-black text-[var(--bs-text)] sm:text-4xl\">كل ما يحتاجه صالونك في مكان واحد</h2><div class=\"mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"bs-panel p-6\"><span class=\"text-3xl\" aria-hidden=\"true\">📅</span><h3 class=\"mt-4 text-lg font-black text-[var(--bs-text)]\">حجز إلكتروني متكامل</h3><p class=\"mt-2 text-sm leading-relaxed text-[var(--bs-text-muted)]\">رابط حجز عام خاص بكل صالون — الزبون يختار الحلاق والخدمة والوقت في أقل من دقيقة، بدون مكالمات ولا انتظار.</p></div><div class=\"bs-panel p-6\"><span class=\"text-3xl\" aria-hidden=\"true\">🔔</span><h3 class=\"mt-4 text-lg font-black text-[var(--bs-text)]\">إشعارات مباشرة</h3><p class=\"mt-2 text-sm leading-relaxed text-[var(--bs-text-muted)]\">تنبيهات فورية على لوحة التحكم وعلى هاتف الزبون مع كل حجز جديد أو تغيير في الدور.</p></div><div class=\"bs-panel p-6\"><span class=\"text-3xl\" aria-hidden=\"true\">⏰</span><h3 class=\"mt-4 text-lg font-black text-[var(--bs-text)]\">تذكيرات تلقائية</h3><p class=\"mt-2 text-sm leading-relaxed text-[var(--bs-text-muted)]\">تذكيرات تُرسل تلقائياً قبل الموعد لتقليل الغياب وحفظ وقت فريقك.</p></div><div class=\"bs-panel p-6\"><span class=\"text-3xl\" aria-hidden=\"true\">👥</span><h3 class=\"mt-4 text-lg font-black text-[var(--bs-text)]\">إدارة فريق الحلاقين</h3><p class=\"mt-2 text-sm leading-relaxed text-[var(--bs-text-muted)]\">أضف الحلاقين وحدّد خدماتهم وأسعارها وأوقات عملهم — كل حلاق بصفحته الخاصة.</p></div><div class=\"bs-panel p-6\"><span class=\"text-3xl\" aria-hidden=\"true\">📊</span><h3 class=\"mt-4 text-lg font-black text-[var(--bs-text)]\">تقارير وإحصائيات</h3><p class=\"mt-2 text-sm leading-relaxed text-[var(--bs-text-muted)]\">تابع الحجوزات والإيرادات وأكثر الخدمات طلباً بلوحات تقارير واضحة.</p></div><div class=\"bs-panel p-6\"><span class=\"text-3xl\" aria-hidden=\"true\">🏢</span><h3 class=\"mt-4 text-lg font-black text-[var(--bs-text)]\">صالونات متعددة</h3><p class=\"mt-2 text-sm leading-relaxed text-[var(--bs-text-muted)]\">كل صالون يحصل على مساحته المستقلة برابطه الخاص — نظام واحد يخدم عدد لا نهائي من الصالونات.</p></div></div></section><section class=\"py-14 sm:py-16\"><div class=\"bs-hairline\"></div><h2 class=\"mt-8 text-3xl font-black text-[var(--bs-text)] sm:text-4xl\">ابدأ في ثلاث خطوات</h2><ol class=\"mt-10 grid gap-5 sm:grid-cols-3\"><li class=\"bs-panel relative overflow-hidden p-6\"><span aria-hidden=\"true\" class=\"pointer-events-none absolute -top-3 left-2 select-none text-7xl font-black text-[var(--bs-text)] opacity-[0.06]\">١</span><span class=\"text-sm font-black text-[var(--bs-primary)]\">الخطوة <!-- -->١</span><h3 class=\"mt-2 text-lg font-black text-[var(--bs-text)]\">أنشئ صالونك</h3><p class=\"mt-2 text-sm leading-relaxed text-[var(--bs-text-muted)]\">سجّل باسم الصالون واسم المستخدم وستحصل على رابط حجز عام خاص بك خلال دقيقة.</p></li><li class=\"bs-panel relative overflow-hidden p-6\"><span aria-hidden=\"true\" class=\"pointer-events-none absolute -top-3 left-2 select-none text-7xl font-black text-[var(--bs-text)] opacity-[0.06]\">٢</span><span class=\"text-sm font-black text-[var(--bs-primary)]\">الخطوة <!-- -->٢</span><h3 class=\"mt-2 text-lg font-black text-[var(--bs-text)]\">أضف فريقك وخدماتك</h3><p class=\"mt-2 text-sm leading-relaxed text-[var(--bs-text-muted)]\">من لوحة التحكم أضف الحلاقين والخدمات والأسعار وأوقات العمل.</p></li><li class=\"bs-panel relative overflow-hidden p-6\"><span aria-hidden=\"true\" class=\"pointer-events-none absolute -top-3 left-2 select-none text-7xl font-black text-[var(--bs-text)] opacity-[0.06]\">٣</span><span class=\"text-sm font-black text-[var(--bs-primary)]\">الخطوة <!-- -->٣</span><h3 class=\"mt-2 text-lg font-black text-[var(--bs-text)]\">شارك رابطك وابدأ</h3><p class=\"mt-2 text-sm leading-relaxed text-[var(--bs-text-muted)]\">انشر الرابط مع زبائنك — الحجوزات تصلكم مباشرة مع إشعارات وتقارير.</p></li></ol></section><section class=\"relative my-10 overflow-hidden rounded-3xl border border-[var(--bs-border)] bg-[var(--bs-surface)] px-6 py-14 text-center\"><div class=\"absolute inset-0\" style=\"background:radial-gradient(ellipse 60% 90% at 50% -20%, rgba(201,162,39,0.18), transparent 65%)\"></div><div class=\"bs-grain\"></div><div class=\"relative\"><h2 class=\"text-3xl font-black text-[var(--bs-text)] sm:text-4xl\">جاهز لتحويل صالونك إلى تجربة رقمية؟</h2><p class=\"mx-auto mt-3 max-w-md text-sm text-[var(--bs-text-muted)] sm:text-base\">أنشئ رابط الحجز الخاص بصالونك الآن — مجاناً، بدون بطاقة ائتمان.</p><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap font-bold transition-all active:scale-95 disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--bs-primary)]/50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-[var(--bs-primary)] text-[var(--bs-on-primary)] hover:bg-[var(--bs-primary-strong)] h-12 rounded-2xl mt-8 px-12 text-base shadow-lg shadow-[var(--bs-primary)]/20\" href=\"/signup\">أنشئ صالونك مجاناً <span aria-hidden=\"true\">←</span></a></div></section><footer class=\"mt-10 border-t border-[var(--bs-border)] py-10\"><div class=\"flex flex-col items-center justify-between gap-6 sm:flex-row\"><div class=\"flex items-center gap-2.5\"><span class=\"text-xl\">💈</span><span class=\"text-base font-black text-[var(--bs-text)]\" dir=\"ltr\">Barber Smart</span></div><nav class=\"flex items-center gap-6 text-sm font-bold\"><a class=\"text-[var(--bs-text-muted)] transition-colors hover:text-[var(--bs-primary)]\" href=\"/signup\">إنشاء صالون</a><a class=\"text-[var(--bs-text-muted)] transition-colors hover:text-[var(--bs-primary)]\" href=\"/admin/login\">دخول المالكين</a></nav></div><div class=\"mt-8 flex flex-col items-center gap-3\"><span class=\"bs-hairline w-40\"></span><p class=\"text-xs text-[var(--bs-text-faint)]\">© <!-- -->2026<!-- --> Barber Smart — جميع الحقوق محفوظة</p></div></footer></div><!--$--><!--/$--></main><section aria-label=\"Notifications alt+T\" tabindex=\"-1\" aria-live=\"polite\" aria-relevant=\"additions text\" aria-atomic=\"false\" data-react-aria-top-layer=\"true\"></section><script src=\"/_next/static/chunks/webpack-1cb9cc019e69c211.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[